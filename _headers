# ============================================================
# 智能分层缓存策略 — Cloudflare Pages Headers
# ============================================================
# 原则：数据常变用短缓存 + stale-while-revalidate
#      静态资源不变用长缓存（带版本指纹需配合文件名 hash）
# ============================================================

# ---- HTML 页面（小体积，每次验证即可）----
/*.html
  Cache-Control: public, max-age=0, must-revalidate

# ---- 数据 JS 文件（常更新，短缓存 + 后台静默刷新）----
/groupsdata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/teamdata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/squaddata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/matchdata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/clubdata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/coachdata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/venuedata.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/bracket_overlay.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/squadmodal.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

# ---- 球员数据 JS（体积最大，中等缓存）----
/playerdata_core.js
  Cache-Control: public, max-age=7200, stale-while-revalidate=86400

/playerdata_career.js
  Cache-Control: public, max-age=7200, stale-while-revalidate=86400

/playerdata_media.js
  Cache-Control: public, max-age=7200, stale-while-revalidate=86400

/playerdata_meta.js
  Cache-Control: public, max-age=7200, stale-while-revalidate=86400

# ---- 核心引擎 JS（变动少，长缓存）----
/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/engine.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/server.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ---- 图片 & 字体（几乎不变）----
/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000

/*.jpg
  Cache-Control: public, max-age=2592000

/*.webp
  Cache-Control: public, max-age=2592000

/*.woff2
  Cache-Control: public, max-age=2592000, immutable
