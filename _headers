# ============================================================
# 高频更新缓存策略
# 图片长期缓存 / 其他内容 5 分钟自动刷新
# ============================================================

# HTML 页面 — 每次都验证最新版本
/*.html
  Cache-Control: no-cache

# JavaScript 数据 & 引擎 — 5分钟缓存 + 后台静默刷新
/*.js
  Cache-Control: max-age=300, stale-while-revalidate=3600

# CSS 样式 — 5分钟缓存 + 后台静默刷新
/*.css
  Cache-Control: max-age=300, stale-while-revalidate=3600

# 图片 — 球员头像 / 国旗等几乎不变，30天缓存
/*.png
  Cache-Control: max-age=2592000, immutable

/*.jpg
  Cache-Control: max-age=2592000, immutable

/*.svg
  Cache-Control: max-age=2592000, immutable

/*.webp
  Cache-Control: max-age=2592000, immutable

# 字体 — 永久缓存
/*.woff2
  Cache-Control: max-age=2592000, immutable
