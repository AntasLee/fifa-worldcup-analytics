# ============================================================
# 世界杯数据站 — HTTP 缓存策略
# ============================================================

# === 比分数据文件 — 30秒即过期，必须向服务器验证 ===
# 用户更新比分后最长 30 秒即可看到最新数据
/matchdata.js
  Cache-Control: max-age=30, must-revalidate

/matchdata_2026.js
  Cache-Control: max-age=30, must-revalidate

/groupsdata.js
  Cache-Control: max-age=30, must-revalidate

# HTML 页面 — 每次都验证最新版本
/*.html
  Cache-Control: no-cache

# JavaScript 数据 & 引擎 — 5分钟缓存 + 后台静默刷新
/*.js
  Cache-Control: max-age=300, stale-while-revalidate=3600

# CSS 样式 — 5分钟缓存 + 后台静默刷新
/*.css
  Cache-Control: max-age=300, stale-while-revalidate=3600

# 图片 — 球员头像 / 国旗等几乎不变，30天缓存
/*.png
  Cache-Control: max-age=2592000, immutable

/*.jpg
  Cache-Control: max-age=2592000, immutable

/*.svg
  Cache-Control: max-age=2592000, immutable

/*.webp
  Cache-Control: max-age=2592000, immutable

# 字体 — 永久缓存
/*.woff2
  Cache-Control: max-age=2592000, immutable
